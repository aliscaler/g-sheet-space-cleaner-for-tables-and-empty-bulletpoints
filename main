function makeAllTablesExact01() {
  const doc = DocumentApp.getActiveDocument();
  const tabs = doc.getTabs();
  
  // Helper function to process a body/container safely
  function cleanContainer(container) {
    // 1. Native find-and-replace for text spaces
    try {
      container.replaceText("^\\s*$", "");
    } catch (e) {
      // Ignore if native replace fails on specific nodes
    }
    
    // 2. Deep structural check with error shielding
    const numChildren = container.getNumChildren();
    for (let i = numChildren - 1; i >= 0; i--) {
      const child = container.getChild(i);
      const type = child.getType();
      
      if (type === DocumentApp.ElementType.LIST_ITEM) {
        const listItem = child.asListItem();
        if (/^\s*$/.test(listItem.getText())) {
          try {
            listItem.removeFromParent();
          } catch (e) {
            // If Docs refuses to delete the last element, clear its text & indent instead
            listItem.setText("");
            listItem.setIndentLeft(0);
          }
        }
      } else if (type === DocumentApp.ElementType.PARAGRAPH) {
        const paragraph = child.asParagraph();
        if (/^\s*$/.test(paragraph.getText())) {
          try {
            paragraph.removeFromParent();
          } catch (e) {
            // If Docs refuses to delete the final paragraph of a section/cell, shrink it
            paragraph.setSpacingBefore(0);
            paragraph.setSpacingAfter(0);
            paragraph.setLineSpacing(1.0);
            paragraph.setFontSize(1);
          }
        }
      } else if (type === DocumentApp.ElementType.TABLE) {
        processTable(child.asTable());
      }
    }
  }

  // Helper function to process tables specifically
  function processTable(table) {
    const numRows = table.getNumRows();
    for (let r = 0; r < numRows; r++) {
      const row = table.getRow(r);
      row.setMinimumHeight(0);
      
      const numCells = row.getNumCells();
      for (let c = 0; c < numCells; c++) {
        const cell = row.getCell(c);
        
        // 0.1 inches = 7.2 points
        cell.setPaddingTop(7.2);
        cell.setPaddingBottom(7.2);
        cell.setPaddingLeft(7.2);
        cell.setPaddingRight(7.2);
        
        cleanContainer(cell);
      }
    }
  }

  // Execute across all document tabs automatically
  tabs.forEach(tab => {
    if (tab.asDocumentTab) {
      const tabBody = tab.asDocumentTab().getBody();
      cleanContainer(tabBody);
      const tables = tabBody.getTables();
      tables.forEach(table => processTable(table));
    }
  });

  // Fallback for main document body
  const mainBody = doc.getBody();
  cleanContainer(mainBody);
  const mainTables = mainBody.getTables();
  mainTables.forEach(table => processTable(table));

  doc.saveAndClose();
  Logger.log("All tabs, tables, and empty bullets cleaned up successfully.");
}
